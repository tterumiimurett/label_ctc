[Unit]
Description=Prolific synchronization PREVIEW (scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/label/label_ctc
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m prolific.ctc_verification_app.activation_cli --journal /home/label/label_ctc/logs/prolific-sync/preview-journal.json scheduler --config /home/label/label_ctc/logs/prolific-sync/preview-config.json --interval 300
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
